local function RPQS_fake_script() -- SGO.LC_Rainbow 
	local script = Instance.new('LocalScript', SGO)

	local sayingstuff = Instance.new("ScreenGui")
	sayingstuff.Name = "CreditsAndAuthentication"
	sayingstuff.ResetOnSpawn = false
	sayingstuff.Parent = game:GetService"Players".LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local sayingstuff3 = Instance.new("TextLabel",sayingstuff)
	sayingstuff3.BackgroundTransparency = 1
	sayingstuff3.BorderSizePixel = 0
	sayingstuff3.Text = ""
	sayingstuff3.Font = "SourceSansProBold"
	sayingstuff3.TextScaled = true
	sayingstuff3.TextStrokeTransparency = 0
	sayingstuff3.Size = UDim2.new(.8,0,.2,0)
	sayingstuff3.AnchorPoint = Vector2.new(.5,1)
	sayingstuff3.Position = UDim2.new(.5,0,1,0)
	local ding = Instance.new("Sound")
	ding.Name = "Ding!"
	ding.Volume = 0.2
	ding.SoundId = "rbxassetid://5035412139"
	ding.Looped = false
	ding.Playing = true
	ding.Parent = sayingstuff
	local text = "Bienvenido Soldier Boy!"
	coroutine.resume(coroutine.create(function()
		for i = 1,string.len(text) do
			game:GetService("RunService").RenderStepped:Wait()
			sayingstuff3.Text = string.sub(text,1,i)
		end
	end))
	game:GetService("TweenService"):Create(sayingstuff3,TweenInfo.new(7,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false,3.5),{AnchorPoint = Vector2.new(.5,0)}):Play()
	game:GetService("Debris"):AddItem(sayingstuff,4.5)
	coroutine.resume(coroutine.create(function()
		while true do
			for i = 0,1,(1/60) do
				game:GetService("RunService").RenderStepped:Wait()
				sayingstuff3.TextColor3 = Color3.fromHSV(0, 0, 1)
			end
		end
	end))
	
end
coroutine.wrap(RPQS_fake_script)()
